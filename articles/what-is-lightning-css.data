[{"_1":2},"content/articles/page",{"_3":4},"data",{"_5":6,"_7":8,"_9":10,"_11":12,"_13":14},"title","What is Lightning CSS","description","Lightning CSS is a Rust-based, high-performance CSS processor that powers Tailwind CSS 4. It delivers massive build speedups, built-in minification, vendor prefixing, and future-proof syntax support with no extra configuration.","publishDate","7/16/2025","element","what-is-lightning-css","path","/articles/what-is-lightning-css"]

[{"_1":2},"content/articles/page",{"_3":4},"data",{"_5":6,"_7":8,"_9":10,"_11":12,"_13":14},"title","You Made My Spirit Brighter","description","Dear Friends, This year has been beyond amazing, and I just want to thank you for all the support and love. Whether you’ve listened to my opinions on Gotham; You’ve put up with me…","publishDate","12/20/2018","element","brighter","path","/articles/brighter"]
